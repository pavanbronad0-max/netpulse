# Copy this file to .env and configure the values for your deployment.
NETPULSE_SECRET_KEY=replace-with-a-long-random-secret
NETPULSE_HOST=0.0.0.0
NETPULSE_PORT=5000
# Port exposed to other LAN devices (e.g. 443 when fronted by a local TLS proxy).
NETPULSE_PUBLIC_PORT=5000
NETPULSE_DATA_DIR=./data
NETPULSE_MAX_FILE_SIZE=26214400
NETPULSE_MONITOR_INTERVAL=3
NETPULSE_DISCOVERY=1
NETPULSE_DISCOVERY_PORT=37020
NETPULSE_COOKIE_SECURE=0
# Set NETPULSE_PUBLIC_SCHEME=https when using a TLS reverse proxy. Direct TLS
# defaults to https when both certificate and key variables are set.
# For direct HTTPS, provide a certificate valid for the host name/IP and its private key.
# NETPULSE_TLS_CERT=./certs/netpulse.crt
# NETPULSE_TLS_KEY=./certs/netpulse.key
